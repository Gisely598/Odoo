<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_custom_purchaseorder_recepcion">
        <t t-call="web.external_layout">
            <div class="page">
                
                <!-- Título principal -->
                <div class="text-center">
                    <strong style="font-size: 20px;">RECEPCIÓN DE MERCADERÍA</strong>
                </div>

                <div class="row" style="font-size: 14px; margin-top: 12px;">
                    <div class="col-6">
                        <h6 t-if="o.state in ['draft', 'sent', 'to approve']">
                            Solicitud de Cotización Nro. <span t-field="o.name" />
                        </h6>
                        <h6 t-if="o.state in ['purchase', 'done']">
                            Orden de Compra Nro. <span t-field="o.name" />
                        </h6>
                        <h6 t-if="o.state == 'cancel'">
                            Orden de Compra Cancelada Nro. <span t-field="o.name" />
                        </h6>
                    </div>
                </div>

                <div class="row" style="font-size: 14px;">
                    <div class="col-6">
                        <strong>
                            <span>Proveedor: <t t-esc="o.partner_id.vat" /></span>
                            <span> - </span>
                            <span t-esc="o.partner_id.name" />
                        </strong>
                        <br />
                        <strong>Recepciones Relacionadas:</strong>
                        <t t-foreach="o.picking_ids" t-as="picking">
                            <div>
                                <span>Nro. de Recepción: </span>
                                <span t-field="picking.name" />
                            </div>
                            <div>
                                <span>Fecha de Recepción: </span>
                                <span t-field="picking.date_done" />
                            </div>
                            <div>
                                <span>Estado: </span>
                                <span t-field="picking.state" />
                            </div>
                            <div>
                                <strong>Sucursal: </strong>
                                <span t-field="picking.location_dest_id.warehouse_id.code" />
                                <span> - </span>
                                <span t-field="picking.location_dest_id.warehouse_id.name" />

                            </div>
                        </t>
                    </div>
                </div>
                
                <table class="table table-sm o_main_table table-borderless mt-2">
                    <thead style="background-color: #f0f0f0; color: black !important;">
                        <tr>
                            <th><strong>Producto</strong></th>
                            <th><strong>Cod.Barra</strong></th>
                            <th><strong>Impuesto</strong></th>
                            <th class="text-end"><strong>Cantidad</strong></th>
                            <th class="text-end"><strong>Precio Unit</strong></th>
                            <th class="text-end"><strong>Total</strong></th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Definir una variable para almacenar la sumatoria del total y descuento -->
                        <t t-set="total_sum" t-value="0.0" />
                        <t t-set="desc_sum" t-value="0.0" />
                        <t t-set="ice_sum" t-value="0.0" />

                        <!-- Recorre las líneas de la orden de compra -->
                        <t t-foreach="o.order_line" t-as="line">
                            <!-- Mostrar la fila solo si el producto NO es de tipo servicio Y qty_received es distinto de 0 -->
                            <tr t-if="line.product_id.detailed_type != 'service' and line.qty_received != 0" style="font-size: 12px;">
								<td><span t-field="line.name" /></td>
                                <td><span t-field="line.product_id.barcode" /></td>
                                <td class="text-end">
                                    <span t-esc="', '.join([tax.name for tax in line.taxes_id])" />
                                </td>
                                <td class="text-end">
                                    <span t-field="line.qty_received" />
                                    <span t-field="line.product_uom.name" />
                                </td>
                                <td class="text-end"><span t-field="line.price_unit" /></td>
                                <td class="text-end">
                                    <!-- Calcular el subtotal por línea -->
                                    <span t-set="subtotal" t-value="line.qty_received * line.price_unit" />
                                    <span t-esc="subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                                    
                                    <!-- Sumar el subtotal al total general -->
                                    <t t-set="total_sum" t-value="total_sum + subtotal" />
                                </td>
                            </tr>
                            <!-- Sumar descuento solo si el producto es de tipo servicio y no tiene ICE aplicado (rs_type_ice == '0') -->
                            <t t-if="line.product_id.detailed_type == 'service' and line.product_id.rs_type_ice == '0'">
                                <t t-set="desc_linea" t-value="line.price_unit" />
                                <t t-set="desc_sum" t-value="desc_sum + desc_linea" />
                            </t>
                            
                            <!-- Sumar ICE solo si el producto es de tipo servicio y tiene ICE aplicado (rs_type_ice en '1' o '2') -->
                            <t t-if="line.product_id.detailed_type == 'service' and line.product_id.rs_type_ice in ['1', '2']">
                                <t t-set="ice_linea" t-value="line.price_unit" />
                                <t t-set="ice_sum" t-value="ice_sum + ice_linea" />
                            </t>
                        </t>
                    </tbody>
                </table>
                
                <!-- Mostrar el total de la sumatoria y el descuento acumulado al final -->
                <div class="row justify-content-end mt-2">
                    <div class="col-4 text-end">
                        <strong>Sub Total:</strong>
                        <span t-esc="total_sum" t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                        <br />
                        <strong>ICE:</strong>
                        <span t-esc="ice_sum" t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                        <br />
                        <strong>Descuento:</strong>
                        <span t-esc="desc_sum" t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                        <br />
                        <strong>Total:</strong>
                        <span t-esc="total_sum + desc_sum + ice_sum" t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                    </div>
                </div>

                <!-- FORMATO DE IMPRESIÓN PIE DE PDF -->
                <div class="footer">
                    <div class="row">
                        <div class="col-4 text-center">
                            <div style="width:80%;border-bottom:2px solid #333; margin:auto;"></div>
                            <div>
                                <span>Entregado por:</span>
                            </div>
                            <span>Nombre:</span>
                        </div>
                        <div class="col-4 text-center">
                            <div style="width:80%;border-bottom:2px solid #333; margin:auto;"></div>
                            <div>
                                <span>Autorizado Gerencia</span>
                            </div>
                            <span>Nombre:</span>
                        </div>
                        <div class="col-4 text-center">
                            <div style="width:80%;border-bottom:2px solid #333; margin:auto;"></div>
                            <div>
                                <span>Recibí Conforme</span>
                            </div>
                            <span>Nombre:</span>
                        </div>
                    </div>
                </div>

                <p t-field="o.notes" class="mt-2" />
            </div>
        </t>
    </template>

    <template id="report_custom_purchaseorder_recepcion_id">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="rs_custom_report_print.report_custom_purchaseorder_recepcion" t-lang="o.partner_id.lang" />
            </t>
        </t>
    </template>
</odoo>
