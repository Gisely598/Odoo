<odoo>
	<!--Formato del  del reporte -->
	<record id="action_format_report_custom" model="report.paperformat">
		<field name="name">Carta Retail</field>
		<field name="format">Letter</field>
		<field name="page_height">0</field>
		<field name="page_width">0</field>
		<field name="orientation">Portrait</field>
		<field name="margin_top">25</field>
		<field name="margin_bottom">20</field>
		<field name="margin_left">7</field>
		<field name="margin_right">7</field>
		<field name="header_line" eval="False" />
		<field name="header_spacing">25</field>
		<field name="dpi">90</field>
	</record>

<!-- Agregar botón en vista formulario -->
	<!-- Orden de Compra -->
	<record id="action_report_custom_purchaseorder" model="ir.actions.report">
		<field name="name">Orden Compra Proveedores</field>
		<field name="model">purchase.order</field> <!-- Modelo vinculado al reporte -->
		<field name="report_type">qweb-pdf</field>
		<field name="report_name">rs_custom_report_print.report_custom_purchaseorder_document_id</field>
		<field name="report_file">rs_custom_report_print.report_custom_purchaseorder_document_id</field>
		<field name="print_report_name">'Orden Compra Proveedores - %s' % (object.name)</field>
		<field name="binding_model_id" ref="model_purchase_order" /> <!-- POR PROBAR -->
		<field name="paperformat_id" ref="rs_custom_report_print.action_format_report_custom" /> 
	</record>



	<!-- Orden de Compra -->

	<record id="action_report_custom_recepcion" model="ir.actions.report">
		<field name="name">Recepción Mercadería</field>
		<field name="model">purchase.order</field> 
		<field name="report_type">qweb-pdf</field>
		<field name="report_name">rs_custom_report_print.report_custom_purchaseorder_recepcion_id</field>
		<field name="report_file">rs_custom_report_print.report_custom_purchaseorder_recepcion_id</field>
		<field name="print_report_name">'Recepción Mercadería - %s' % (object.name)</field>
		<field name="binding_model_id" ref="model_purchase_order" /> 
		<field name="paperformat_id" ref="rs_custom_report_print.action_format_report_custom" /> 
	</record>

	<!-- Guía de Remisión -->

	<record id="stock_picking_action_report" model="ir.actions.report">
		<field name="name">Guía de Remisión</field>
		<field name="model">stock.picking</field>
		<field name="report_type">qweb-pdf</field>
		<field name="report_name">rs_custom_report_print.report_stock_picking</field>
		<field name="report_file">rs_custom_report_print.report_stock_picking</field>
		<field name="print_report_name">'Guía de remisión - %s' % (object.name)</field>
		<field name="binding_model_id" ref="stock.model_stock_picking" />
		<field name="paperformat_id" ref="rs_custom_report_print.action_format_report_custom" />
	</record>

	<!-- Leyenda de factura -->

	<record id="stock_picking_action_report" model="ir.actions.report">
		<field name="name">Leyenda</field>
		<field name="model">stock.picking</field>
		<field name="report_type">qweb-pdf</field>
		<field name="report_name">rs_custom_report_print.report_stock_picking</field>
		<field name="report_file">rs_custom_report_print.report_stock_picking</field>
		<field name="print_report_name">'Guía de remisión - %s' % (object.name)</field>
		<field name="binding_model_id" ref="stock.model_stock_picking" />
		<field name="paperformat_id" ref="rs_custom_report_print.action_format_report_custom" />
	</record>

</odoo>