<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="stock_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Aca se agrega una columna nueva para agregar un campo -->
            <xpath expr="//group[@name='other_infos']" position="after">
                <group string="Información del Pedido" name="delivered_infos">
                    <field name="delivered_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>