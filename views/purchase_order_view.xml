<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_custom_report" model="ir.ui.view">
        <field name="name">purchase.order.form.custom.report</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Añadir el nuevo botón de reporte PDF con ícono de impresora -->
            <xpath expr="//header/button[@name='action_rfq_send']" position="after">
                <button name="action_report_custom_purchaseorder"
                        string="Imprimir OC"
                        type="object"
                        class="btn-primary"/>
            </xpath>
        </field>
    </record>
</odoo>